# Gmail address that receives forwarded emails
IMAP_USER=you@gmail.com

# Gmail App Password (NOT your regular password!)
# How to get one:
#   1. Enable 2FA on your Google Account
#   2. Go to https://myaccount.google.com/security
#   3. Under "Signing in to Google" → "App passwords"
#   4. Select app "Mail", device "Other" → name it "Farm"
#   5. Copy the 16-character password (format: abcd efgh ijkl mnop)
IMAP_PASS=abcd efgh ijkl mnop

# Your catch-all domain (emails like random@yourdomain.com will forward here)
EMAIL_DOMAIN=yourdomain.com

# Optional: IMAP server (default: Gmail)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993

# Optional: Max registration attempts per run
# MAX_ATTEMPTS=20

# Optional: Results file path
# RESULTS_FILE=results.json
